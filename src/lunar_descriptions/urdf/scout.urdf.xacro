<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scout">
  <xacro:include filename="$(find lunar_descriptions)/urdf/common.xacro"/>

  <!-- ===== 腿宏：髋 + 膝 + 足，均绕 y 轴（矢状面运动）===== -->
  <xacro:macro name="leg" params="prefix x y">
    <link name="${prefix}_upper_leg">
      <visual>
        <geometry><box size="0.03 0.03 0.14"/></geometry>
        <material name="lunar_blue"/>
      </visual>
      <collision>
        <geometry><box size="0.03 0.03 0.14"/></geometry>
      </collision>
      <xacro:box_inertial mass="0.15" lx="0.03" ly="0.03" lz="0.14"/>
    </link>
    <joint name="${prefix}_hip_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_upper_leg"/>
      <origin xyz="${x} ${y} -0.03" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.2" upper="1.2" effort="15" velocity="6"/>
    </joint>

    <link name="${prefix}_lower_leg">
      <visual>
        <geometry><box size="0.03 0.03 0.14"/></geometry>
        <material name="lunar_blue"/>
      </visual>
      <collision>
        <geometry><box size="0.03 0.03 0.14"/></geometry>
      </collision>
      <xacro:box_inertial mass="0.1" lx="0.03" ly="0.03" lz="0.14"/>
    </link>
    <joint name="${prefix}_knee_joint" type="revolute">
      <parent link="${prefix}_upper_leg"/>
      <child link="${prefix}_lower_leg"/>
      <origin xyz="0 0 -0.14" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.6" upper="1.6" effort="15" velocity="6"/>
    </joint>

    <link name="${prefix}_foot">
      <visual>
        <origin xyz="0 0 -0.015" rpy="0 0 0"/>
        <geometry><box size="0.10 0.10 0.03"/></geometry>
        <material name="lunar_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 -0.015" rpy="0 0 0"/>
        <geometry><box size="0.10 0.10 0.03"/></geometry>
      </collision>
      <xacro:box_inertial mass="0.05" lx="0.10" ly="0.10" lz="0.03"/>
    </link>
    <!-- 脚关节仍固定在小腿末端 -0.14 处；盒子下移 1.5cm 使底面与竖直站姿着地面齐平 -->
    <joint name="${prefix}_foot_joint" type="fixed">
      <parent link="${prefix}_lower_leg"/>
      <child link="${prefix}_foot"/>
      <origin xyz="0 0 -0.14" rpy="0 0 0"/>
    </joint>
    <!-- 高摩擦：足为刚性连接，步态中足底随小腿倾斜，需更高摩擦防止打滑 -->
    <gazebo reference="${prefix}_foot">
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>
  </xacro:macro>

  <!-- ===== 身体 ===== -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.30 0.20 0.06"/></geometry>
      <material name="lunar_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.30 0.20 0.06"/></geometry>
    </collision>
    <xacro:box_inertial mass="3.0" lx="0.30" ly="0.20" lz="0.06"/>
  </link>
  <gazebo reference="base_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
  </gazebo>

  <!-- ===== 四条腿 ===== -->
  <xacro:leg prefix="fl" x="0.12" y="0.08"/>
  <xacro:leg prefix="fr" x="0.12" y="-0.08"/>
  <xacro:leg prefix="rl" x="-0.12" y="0.08"/>
  <xacro:leg prefix="rr" x="-0.12" y="-0.08"/>

  <!-- ===== 3D 激光雷达（顶部前侧，输出 sensor_msgs/PointCloud2） ===== -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
      <material name="lunar_black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
    </collision>
    <xacro:box_inertial mass="0.1" lx="0.08" ly="0.08" lz="0.06"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.15 0 0.05" rpy="0 0 0"/>
  </joint>
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>1</resolution>
            <min_angle>-0.436332</min_angle>
            <max_angle>0.174533</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <plugin name="scout_lidar_3d" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/scout</namespace>
          <remapping>~/out:=scan_3d</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>scout/lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===== gazebo_ros2_control 桥接 ===== -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <robot_param>robot_description</robot_param>
      <robot_param_node>scout_rsp</robot_param_node>
      <parameters>$(find lunar_control)/config/scout_controllers.yaml</parameters>
      <ros>
        <namespace>scout</namespace>
      </ros>
    </plugin>
  </gazebo>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <xacro:macro name="leg_joints" params="prefix">
      <joint name="${prefix}_hip_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>
      <joint name="${prefix}_knee_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>
    </xacro:macro>
    <xacro:leg_joints prefix="fl"/>
    <xacro:leg_joints prefix="fr"/>
    <xacro:leg_joints prefix="rl"/>
    <xacro:leg_joints prefix="rr"/>
  </ros2_control>
</robot>
